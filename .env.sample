# Optional: environment variables override the matching values in
# config.yaml (or fully replace it - config.yaml isn't required at all if
# every value below is set as an env var instead, e.g. on Render/Koyeb/
# Heroku dashboards). None of these are required locally if config.yaml
# is already filled in.

ANIME_BOT_TOKEN=123456:YOUR-TELEGRAM-BOT-TOKEN
ANIME_BOT_OWNER_ID=123456789
ANIME_BOT_SUDO_USERS=111111111,222222222
ANIME_BOT_START_PICS=https://example.com/pic1.jpg,https://example.com/pic2.jpg

# MongoDB connection. ANIME_BOT_MONGO_URI takes priority; MONGODB_URI and
# MONGO_URL are also recognized since some hosts/add-ons set those names
# automatically when you attach a database.
ANIME_BOT_MONGO_URI=mongodb://localhost:27017
ANIME_BOT_MONGO_DB_NAME=anime_mod_bot

# health-check web server port. Render/Koyeb/Heroku set PORT
# automatically - you normally don't need to set this yourself.
PORT=8080

ANIME_BOT_LOG_LEVEL=INFO
